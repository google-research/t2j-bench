# Template for coding-agent/coding_agent/.env (which is gitignored).
# Copy this file to .env and fill in the placeholders:
#   cp coding-agent/coding_agent/.env.example coding-agent/coding_agent/.env

# Google Cloud project used for Vertex AI. Replace with your own project id.
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="global"

# Model the agent runs
CODING_AGENT_MODEL=""

# Claude Code uses 64k default max output tokens for Opus 4.6.
CODING_AGENT_MAX_OUTPUT_TOKENS=64000

# This setting is mainly relevant to Gemini-style thinking config and is not
# used as the primary Claude 4.6 thinking control.
CODING_AGENT_THINKING_LEVEL="high"

CODING_AGENT_INCLUDE_THOUGHTS=1
CODING_AGENT_PRINT_THOUGHTS=0
CODING_AGENT_PRINT_TOOL_CALL_COUNTS=0

CODING_AGENT_COMPACT_CONTEXT_LIMIT=1048576
CODING_AGENT_COMPACT_TRIGGER_RATIO=0.25
CODING_AGENT_COMPACT_KEEP_RATIO=0.15

ADK_PRESERVE_THOUGHT_SIGNATURES=1
