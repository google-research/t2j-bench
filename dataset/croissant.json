  "@type": "sc:Dataset",
  "name": "T2J-Bench Source Training Pipelines",
  "alternateName": "T2J-Bench",
  "description": "A benchmark dataset of 45 LLaMA-Factory-style PyTorch source training repositories for PyTorch-to-JAX repository migration. Each record is one end-to-end training pipeline for one model family and one training method: supervised fine-tuning (SFT), direct preference optimization (DPO), or proximal policy optimization (PPO). Each retained pipeline contains the source-side configuration parsing, tokenizer or processor construction, dataset loading, collation, model invocation, loss construction, optimizer interaction, and objective-specific artifacts required by the benchmark evaluator.",
  "url": "https://anonymous.4open.science/r/t2j-bench-C308/",
  "codeRepository": "https://anonymous.4open.science/r/t2j-bench-C308/",
  "version": "1.0.0",
  "datePublished": "2026-05-04",
  "dateModified": "2026-05-04",
  "license": "https://spdx.org/licenses/Apache-2.0.html",
  "creator": [
    {
      "@type": "sc:Organization",
      "name": "Anonymous NeurIPS 2026 submission authors"
    }
  ],
  "publisher": [
    {
      "@type": "sc:Organization",
      "name": "Anonymous NeurIPS 2026 submission authors"
    }
  ],
  "keywords": [
    "PyTorch-to-JAX migration",
    "repository migration",
    "coding agents",
    "training pipelines",
    "SFT",
    "DPO",
    "PPO",
    "observational equivalence"
  ],
  "inLanguage": [
    "en"
  ],
  "isLiveDataset": false,
  "citeAs": "Anonymous. T2J-Bench Source Training Pipelines: 45 PyTorch training repositories for benchmarking PyTorch-to-JAX migration. NeurIPS 2026 Evaluations and Datasets submission.",
  "conformsTo": [
    "http://mlcommons.org/croissant/1.1",
    "http://mlcommons.org/croissant/RAI/1.0"
  ],
  "rai:dataLimitations": [
    "The dataset is a benchmark suite of source-code training pipelines, not a corpus for training language or vision models and not a model-checkpoint dataset.",
    "Coverage is intentionally limited to LLaMA-Factory-style PyTorch repositories, three alignment and fine-tuning methods, and 15 selected Transformer-based text or multimodal model families.",
    "The retained repositories are bounded-evaluation targets; they are designed for migration and equivalence testing and may not be suitable as production training systems without additional engineering review.",
    "The hosted dataset URL and code repository URL point to the anonymous reviewer-accessible release."
  ],
  "rai:dataBiases": [
    "Selection bias is present toward popular LLM and multimodal Transformer families, Hugging Face Transformers-style model implementations, and PyTorch source repositories that can be exercised under a deterministic bounded evaluator.",
    "The benchmark emphasizes cross-framework migration failures observable through SFT, DPO, and PPO contracts; it under-represents non-Transformer models, non-Python ecosystems, data engineering pipelines, and large-scale distributed production training.",
    "The repository templates share a common LLaMA-Factory-style organization, so coding agents may benefit from recognizing repeated structure across tasks."
  ],
  "rai:personalSensitiveInformation": "No personal or sensitive user records are intentionally included. The dataset consists of source code, configuration files, README-style documentation, and small demo/configuration data used to exercise training pipelines. As with any source-code release, maintainers should scan comments, example URLs, and vendored upstream files before public release.",
  "rai:dataUseCases": [
    "Benchmarking coding agents and models on semantic-preserving PyTorch-to-JAX repository migration.",
    "Studying failures in preserving callable interfaces, numeric behavior, gradients, objective-specific tensors, and short-horizon training dynamics.",
    "Developing and stress-testing external evaluators for repository-level migration under fixed observation contracts.",
    "Research use in software engineering, ML systems, and agent evaluation."
  ],
  "rai:dataSocialImpact": "The dataset can improve evaluation rigor for coding agents by exposing gaps between local smoke tests and externally verified training semantics. Negative impacts include overfitting agents to the benchmark structure, using pass rates as a broad proxy for general software engineering ability, or encouraging expensive migration loops without stronger validation. The dataset mitigates these risks by documenting the bounded scope, exposing the 45 source tasks, and separating dataset records from hidden evaluator internals.",
  "rai:hasSyntheticData": true,
  "rai:dataCollection": "The 45 records were curated from local dpo/, ppo/, and sft/ folders. For each of 15 model families, the dataset includes one torch_orig PyTorch source training pipeline for each of SFT, DPO, and PPO.",
  "prov:wasDerivedFrom": [
    {
      "@id": "https://github.com/hiyouga/LLaMA-Factory",
      "name": "LLaMA-Factory-style training pipeline organization"
    },
    {
      "@id": "https://github.com/huggingface/transformers",
      "name": "Hugging Face Transformers-style local model implementations"
    }
  ],
  "prov:wasGeneratedBy": [
    {
      "@type": "prov:Activity",
      "name": "Pipeline generation and curation",
      "description": "Generated and curated LLaMA-Factory-style PyTorch training repositories for every combination of 3 training methods and 15 model families. The curation retains the source-side interfaces and artifacts needed for external migration evaluation."
    },
    {
      "@type": "prov:Activity",
      "name": "Reference-side executability filtering",
      "description": "Each retained PyTorch repository was required to support bounded execution, deterministic behavior under fixed seeds, and exposure of artifacts required by the staged benchmark contract."
    },
    {
      "@type": "prov:Activity",
      "name": "Croissant metadata construction",
      "description": "Constructed this Croissant metadata file to enumerate the 45 training pipeline records and describe the dpo/, ppo/, and sft/ source-code file sets. Bytecode caches, generated attempts, evaluator outputs, and candidate JAX repositories are excluded from the dataset distribution.",
      "prov:endedAtTime": "2026-05-04T00:00:00Z"
    }
  ],
